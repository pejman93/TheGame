# Copy to .env.local for local development. On Vercel, set these in
# Project Settings -> Environment Variables. Never commit real keys.

# OpenRouter key used for "transform my photo with a prompt".
# Leave empty and the original photos are used instead.
OPENROUTER_API_KEY=

# Optional: image model on OpenRouter that supports image output.
OPENROUTER_IMAGE_MODEL=google/gemini-2.5-flash-image

# Added automatically when you connect a Vercel Blob store to the project.
# Without it, files are stored in ./.data (local development only).
BLOB_READ_WRITE_TOKEN=

# Optional: public URL of the site (used as the OpenRouter referer).
NEXT_PUBLIC_SITE_URL=http://localhost:3000
